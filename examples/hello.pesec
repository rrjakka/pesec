mutab point_new = fn(x, y) {
    struct {
        x = x,
        y = y,
        sub_struct = struct {
            test_value = "test"
        },
        print=fn(this) println("{x=", this.x, ",y=", this.y, "}")
    };
};

# damn

mutab p1 = point_new(10, 30);
mutab p2 = point_new(20, 40);

(p1).print(p1);
((((p2)))).print(p2);

println(point_new(99, 88).sub_struct.test_value);

p1.x = 69;
p1.print(p1);



